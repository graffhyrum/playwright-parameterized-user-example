{
  "name": "@monorepo/dashboard",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --hot run src/index.ts",
    "start": "bun run src/index.ts",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix . && oxfmt --write .",
    "format": "oxfmt --write .",
    "fix": "oxlint --fix . && oxfmt --write .",
    "vet": "bun check && bunx oxlint . && bunx oxfmt --check ."
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:"
  },
  "dependencies": {
    "@monorepo/utils": "workspace:*",
    "arktype": "catalog:"
  },
  "peerDependencies": {
    "@typescript/native-preview": "catalog:"
  }
}
