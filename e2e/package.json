{
  "name": "@monorepo/e2e",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:"
  },
  "dependencies": {
    "@monorepo/utils": "workspace:*"
  },
  "peerDependencies": {
    "@typescript/native-preview": "catalog:"
  },
  "scripts": {
    "typecheck": "bun check",
    "dev": "bun run src/index.ts",
    "test": "bunx playwright test",
    "test:ui": "bunx playwright test --ui",
    "test:debug": "bunx playwright test --debug",
    "test:report": "bunx playwright show-report",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix . && oxfmt --write .",
    "format": "oxfmt --write .",
    "vet": "bun typecheck && bun format && bun lint"
  }
}
