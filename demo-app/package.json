{
  "name": "@monorepo/demo-app",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run src/index.ts",
    "dev:production": "bun run env.ts production",
    "dev:staging": "bun run env.ts staging",
    "dev:development": "bun run env.ts development",
    "start": "bun run src/index.ts",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix . && oxfmt --write .",
    "format": "oxfmt --write .",
    "fix": "oxlint --fix . && oxfmt --write .",
    "vet": "bun check && bunx oxlint . && bunx oxfmt --check ."
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:"
  },
  "dependencies": {
    "@monorepo/utils": "workspace:*"
  },
  "peerDependencies": {
    "@typescript/native-preview": "catalog:"
  }
}
